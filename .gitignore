/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Dependencies
/node_modules
/.pnp
.pnp.js

# Build / Ionic / Angular outputs
/www
/dist
/out-tsc
/.angular/cache
/.ionic

# Native platforms (kung gumagamit ng Capacitor / Cordova)
/android/app/build
/android/.gradle
/ios/App/Pods
/ios/App/build

# Testing & coverage
/coverage

